<Page
    x:Class="XBsync.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:XBsync.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <DataTemplate x:Key="GameRowTemplate" x:DataType="models:GameTitle">
            <Grid Padding="8" ColumnSpacing="16" MinHeight="94">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Width="68" Height="78">
                    <Grid>
                        <FontIcon Glyph="&#xE7FC;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image Stretch="UniformToFill"><Image.Source><BitmapImage UriSource="{x:Bind ArtworkUri}" /></Image.Source></Image>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind LastPlayedText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GameTileTemplate" x:DataType="models:GameTitle">
            <StackPanel Width="158" Padding="8" Spacing="8">
                <Border Height="154" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE7FC;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image Stretch="UniformToFill"><Image.Source><BitmapImage UriSource="{x:Bind ArtworkUri}" /></Image.Source></Image>
                    </Grid>
                </Border>
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind LastPlayedText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FileRowTemplate" x:DataType="models:CloudSaveFile">
            <Grid ColumnSpacing="12" Padding="4,10" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="100" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" FontSize="12" />
                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText}" FontSize="12" />
                <TextBlock Grid.Column="3" Text="{x:Bind Type}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <Style x:Key="StretchListItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE753;" FontSize="36" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <StackPanel Spacing="3">
                        <TextBlock Text="XBsync" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="BrandSubtitle" Text="Xbox games &amp; cloud saves" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="ConnectionHeader" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.LastCheckText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid Grid.Column="2" ColumnSpacing="12" VerticalAlignment="Center" MinWidth="245">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <PersonPicture Width="42" Height="42" DisplayName="{x:Bind ViewModel.Gamertag, Mode=OneWay}">
                        <PersonPicture.ProfilePicture><BitmapImage UriSource="{x:Bind ViewModel.AvatarUri, Mode=OneWay}" /></PersonPicture.ProfilePicture>
                    </PersonPicture>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.Gamertag, Mode=OneWay}" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="XUID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.Xuid, Mode=OneWay}" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono" FontSize="14" VerticalAlignment="Center" />
                            <Button Command="{x:Bind ViewModel.CopyXuidCommand}" Padding="5" ToolTipService.ToolTip="Copy XUID" AutomationProperties.Name="Copy XUID">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="220" CompactPaneLength="48"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True"
                        SelectionChanged="Navigation_SelectionChanged" Background="Transparent">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GamesNavigation" Content="Games" Tag="Games" Icon="XboxOneConsole" />
                <NavigationViewItem Content="Cloud Saves" Tag="CloudSaves"><NavigationViewItem.Icon><FontIcon Glyph="&#xE753;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="Profiles" Icon="Contact" />
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Border x:Name="SidebarCard" Style="{StaticResource CardStyle}" Margin="12,0,12,16" Padding="14">
                    <StackPanel Spacing="10">
                        <FontIcon Glyph="&#xE753;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" FontSize="28" />
                        <TextBlock Text="Xbox Cloud Saves" FontWeight="SemiBold" />
                        <TextBlock Text="Browse save containers and download files from your Xbox cloud saves." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>
            <Grid Margin="20,8,20,16" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=TwoWay}" Severity="Error" Title="Request failed" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <Border Grid.Row="1" Visibility="{x:Bind ViewModel.AuthenticationVisibility, Mode=OneWay}" Style="{StaticResource CardStyle}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Connect your Xbox profile" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Retry local" Command="{x:Bind ViewModel.RetrySilentSignInCommand}" />
                            <Button Content="Sign in" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SignInCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="LibraryLayout" Grid.Row="2" Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}" ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="BrowserColumn" Width="0.9*" /><ColumnDefinition x:Name="DetailsColumn" Width="1.1*" /></Grid.ColumnDefinitions>
                    <Grid x:Name="BrowserPane" RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Your Games" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                                <ToggleButton Content="Grid" IsChecked="{x:Bind ViewModel.IsGridView, Mode=TwoWay}" ToolTipService.ToolTip="Switch between list and grid" />
                            </StackPanel>
                        </Grid>
                        <TextBox Grid.Row="1" PlaceholderText="Search games…" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search games" />
                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{x:Bind ViewModel.Filters}" SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Filter games" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Sorts}" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort games" />
                        </Grid>
                        <Grid Grid.Row="3">
                            <ListView ItemsSource="{x:Bind ViewModel.Games}" SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource GameRowTemplate}" ItemContainerStyle="{StaticResource StretchListItem}"
                                      SelectionMode="Single" Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}" AutomationProperties.Name="Played games list" />
                            <GridView ItemsSource="{x:Bind ViewModel.Games}" SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource GameTileTemplate}" SelectionMode="Single"
                                      Visibility="{x:Bind ViewModel.GridVisibility, Mode=OneWay}" AutomationProperties.Name="Played games grid" />
                            <StackPanel Visibility="{x:Bind ViewModel.EmptyGamesVisibility, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="300">
                                <FontIcon Glyph="&#xE7FC;" FontSize="42" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="No games to display" FontSize="18" HorizontalAlignment="Center" />
                                <TextBlock Text="Connect your profile, or change the search and filter." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingGames, Mode=OneWay}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="DetailsPane" Grid.Column="1" RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid x:Name="CompactControls" Visibility="Collapsed">
                            <Button Content="← Games" Click="BackToGames_Click" />
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.GameDetailsVisibility, Mode=OneWay}" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Height="104" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE7FC;" />
                                        <Image Stretch="UniformToFill"><Image.Source><BitmapImage UriSource="{x:Bind ViewModel.SelectedGame.ArtworkUri, Mode=OneWay}" /></Image.Source></Image>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGame.Name, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGame.LastPlayedText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.FileStateMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2" Visibility="{x:Bind ViewModel.NoGameVisibility, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE753;" FontSize="48" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Choose a game" FontSize="22" HorizontalAlignment="Center" />
                            <TextBlock Text="Save containers and attached files will appear here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                        </StackPanel>
                        <Pivot Grid.Row="2" Visibility="{x:Bind ViewModel.GameDetailsVisibility, Mode=OneWay}">
                            <PivotItem Header="Save Files">
                                <ScrollViewer x:Name="SaveFilesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="SaveFilesScroller_SizeChanged">
                                    <Grid x:Name="SaveFilesLayout" Height="520" RowSpacing="12">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Cloud Save Files" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.FileStateMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Row="1" Header="Save container" PlaceholderText="Choose a save container" ItemsSource="{x:Bind ViewModel.Containers}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Save container">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:CloudSaveContainer">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Id}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Grid.Row="2" Spacing="8">
                                            <Button Content="Download Selected" Command="{x:Bind ViewModel.DownloadSelectedCommand}" ToolTipService.ToolTip="Select one or more files" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Refresh saves" Command="{x:Bind ViewModel.RefreshSavesCommand}" />
                                                <Button Content="Open Download Folder" Command="{x:Bind ViewModel.OpenDownloadFolderCommand}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Row="3" MinHeight="144" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                <Grid Padding="44,12,16,12" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="100" /><ColumnDefinition Width="70" /><ColumnDefinition Width="132" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="Name" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Grid.Column="1" Text="Size" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Grid.Column="2" Text="Modified" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Grid.Column="3" Text="Type" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                                </Grid>
                                                <ListView x:Name="FilesList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" ItemTemplate="{StaticResource FileRowTemplate}" ItemContainerStyle="{StaticResource StretchListItem}"
                                                          SelectionMode="Multiple" SelectionChanged="Files_SelectionChanged" IsEnabled="{x:Bind ViewModel.CanSelectFiles, Mode=OneWay}" IsMultiSelectCheckBoxEnabled="True" AutomationProperties.Name="Cloud save files" />
                                                <ProgressRing Grid.Row="1" Width="36" Height="36" IsActive="{x:Bind ViewModel.IsLoadingFiles, Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="14">
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="{x:Bind ViewModel.FocusedFile.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind ViewModel.FocusedFile.LogicalPath, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.TransferVisibility, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.TransferPercent, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.IsTransferIndeterminate, Mode=OneWay}" VerticalAlignment="Center" AutomationProperties.Name="Save transfer progress" />
                                                    <Button Grid.Column="1" Content="Cancel transfer" Command="{x:Bind ViewModel.CancelTransferCommand}" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.TransferText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </PivotItem>
                            <PivotItem Header="Details">
                                <ScrollViewer>
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="Game identity" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="Title ID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedGame.TitleId, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="Service configuration ID (SCID)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedGame.ServiceConfigurationId, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="Package family name" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedGame.PackageFamilyName, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="Blank values were not returned by Xbox Live. Played-game history does not prove cloud save availability or write permission." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </PivotItem>
                            <PivotItem Header="Activity">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="XBsync activity for this session, including download destinations and outcomes." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Activity}" SelectionMode="None">
                                        <ListView.ItemTemplate><DataTemplate x:DataType="models:ActivityEntry"><StackPanel Padding="4,8" Spacing="5"><TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind TimeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </PivotItem>
                        </Pivot>
                    </Grid>
                </Grid>
                <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.ProfileVisibility, Mode=OneWay}">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="20">
                        <TextBlock Text="Your Xbox Profile" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.Gamertag, Mode=OneWay}" FontSize="24" />
                        <TextBlock Text="XUID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Xuid, Mode=OneWay}" FontSize="26" FontFamily="Cascadia Mono" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Copy XUID" Command="{x:Bind ViewModel.CopyXuidCommand}" /><Button Content="Disconnect" Command="{x:Bind ViewModel.DisconnectCommand}" /></StackPanel>
                        <TextBlock Text="Local Xbox credential reuse is best effort. Use Sign in to explicitly choose an account when local identity is ambiguous." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="2" Visibility="{x:Bind ViewModel.SettingsVisibility, Mode=OneWay}">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="20">
                        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Microsoft sign-in" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Sign in with Microsoft to connect your Xbox profile or switch accounts." TextWrapping="Wrap" />
                                <Button Content="Sign in with Microsoft" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SignInCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Cloud saves" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Choose a game and save container, then select one or more files to download. Existing local files are kept; duplicate names receive a numbered suffix." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Button Content="Open Download Folder" Command="{x:Bind ViewModel.OpenDownloadFolderCommand}" HorizontalAlignment="Left" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionText" Text="Version 1.0.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Created by" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <HyperlinkButton Content="D3FEKT" NavigateUri="https://github.com/D3FEKT" Padding="4,0" AutomationProperties.Name="D3FEKT on GitHub" />
                                </StackPanel>
                                <TextBlock Text="If XBsync helped you, you can support the project on Ko-fi." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton NavigateUri="https://ko-fi.com/d3fekt" Padding="4" HorizontalAlignment="Left" ToolTipService.ToolTip="Support D3FEKT on Ko-fi" AutomationProperties.Name="Support D3FEKT on Ko-fi">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="White" Padding="3">
                                            <Image Source="ms-appx:///Assets/kofi.png" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="Support on Ko-fi" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
        <Border Grid.Row="2" Padding="20,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button x:Name="ShowDetailsButton" Grid.Column="1" Content="Save details →" Click="ShowDetails_Click" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
